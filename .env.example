DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vn_market_db

# Cách chạy chính: đọc FPT.csv, VCB.csv và VNM.csv từ thư mục này.
STOCK_CSV_DIR=data/stocks

# Tùy chọn Open API: để STOCK_CSV_DIR trống và cấu hình nguồn có khóa.
# Ví dụ VNSTOCK_SOURCE=ssi với hai khóa SSI bên dưới.
VNSTOCK_SOURCE=
SSI_API_KEY=
SSI_API_SECRET=
